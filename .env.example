# Pwnagotchi Environment Configuration Example

# Device Name & Personality
PWNAGOTCHI_NAME="pwnagotchi"
PWNAGOTCHI_LANG="en"

# Bettercap Interface
BETTERCAP_HOSTNAME="localhost"
BETTERCAP_PORT=8081
BETTERCAP_USERNAME="pwnagotchi"
BETTERCAP_PASSWORD="changeme_bettercap_password"

# Web UI Dashboard
WEB_UI_PORT=8080
WEB_UI_USERNAME="admin"
WEB_UI_PASSWORD="changeme_web_password"

# Optional Cloud API Keys (Leave blank if unused)
WPA_SEC_API_KEY="your_wpa_sec_api_key_here"
WIGLE_API_KEY="your_wigle_api_key_here"
NET_POS_API_KEY="your_mozilla_location_api_key_here"
